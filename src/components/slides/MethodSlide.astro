---
import SlideFrame from "../deck/SlideFrame.astro";
import { methodSteps, models, prompt, promptReason, toolName } from "../../data/experiments.ts";
---

<section>
  <SlideFrame kicker="Protocolo">
    <div class="method">
      <ol class="steps">
        {
          methodSteps.map((step, index) => (
            <li class="rise" style={`--d: ${index}`}>
              <span>{step.index}</span>
              <strong>{step.title}</strong>
              <p>{step.text}</p>
            </li>
          ))
        }
      </ol>
      <div class="prompt-panel rise" style={`--d: ${methodSteps.length}`}>
        <div class="model-pills">
          {models.map((model) => <span>{model.label}</span>)}
          <span>{toolName}</span>
        </div>
        <div class="prompt-grid">
          <div>
            <p class="prompt-kicker">Prompt</p>
            <blockquote>
              <p>“{prompt}”</p>
            </blockquote>
          </div>
          <div>
            <p class="prompt-kicker">Por quê</p>
            <p class="prompt-body">{promptReason}</p>
          </div>
        </div>
      </div>
    </div>
  </SlideFrame>
  <aside class="notes">
    O prompt foi o mesmo em todas as máquinas. A ferramenta foi o LM Studio. O monitoramento não foi padronizado entre os sistemas.
  </aside>
</section>
