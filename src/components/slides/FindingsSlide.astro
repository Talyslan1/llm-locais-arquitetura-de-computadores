---
import SlideFrame from "../deck/SlideFrame.astro";
import { findings, limitations } from "../../data/experiments.ts";

const items = findings();
---

<section>
  <SlideFrame kicker="Leitura do experimento">
    <div class="findings">
      <ul>
        {
          items.map((item, index) => (
            <li class="rise" style={`--d: ${index}`}>
              <span>{item.title}</span>
              <p>{item.text}</p>
            </li>
          ))
        }
      </ul>
      <aside class="limits rise" style={`--d: ${items.length}`}>
        <h2>Limites deste experimento</h2>
        <ol>
          {limitations.map((item) => <li>{item}</li>)}
        </ol>
      </aside>
    </div>
  </SlideFrame>
  <aside class="notes">
    Os limites são restrições deste ensaio. As observações descrevem o que foi medido, não uma hierarquia de máquinas.
  </aside>
</section>
